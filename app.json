{
  "expo": {
    "name": "Kipo",
    "slug": "kipo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kipo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.angeldev11.kipo",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.angeldev11.kipo",
      "allowBackup": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "Kipo usa la cámara para escanear tus documentos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kipo necesita acceso a tus fotos para adjuntarlas a un documento.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "react-native-quick-crypto",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Kipo usa Face ID para desbloquear tu bóveda.",
          "configureAndroidBackup": true
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c93f9b9b-160f-4841-8e93-9e72b110810b"
      }
    },
    "owner": "angeldev11"
  }
}
